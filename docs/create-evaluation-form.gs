/**
 * ສ້າງແບບສອບຖາມປະເມີນລະບົບ TonNam SRMS
 * Smart Restaurant Management System — ແບບປະເມີນຄວາມພໍໃຈ
 *
 * ວິທີໃຊ້:
 *  1. ເປີດ Google Apps Script (script.google.com)
 *  2. ສ້າງ Project ໃໝ່ ແລ້ວວາງ Code ນີ້ໄວ້ໃນ Code.gs
 *  3. ຄລິກ Run → createSRMSEvaluationForm
 *  4. ອະນຸຍາດ Permission ໃຫ້ Script ສ້າງ Google Form
 *  5. Link ຂອງ Form ຈະສະແດງຢູ່ Execution Log
 */

function createSRMSEvaluationForm() {
  // ─── ສ້າງ Form ─────────────────────────────────────────────────────────────
  const form = FormApp.create('ແບບສອບຖາມການປະເມີນລະບົບ TonNam SRMS');

  form.setDescription(
    'ແບບສອບຖາມນີ້ ມີຈຸດປະສົງເພື່ອ ປະເມີນຄວາມພໍໃຈ ແລະ ຄວາມຄິດເຫັນຂອງທ່ານ ' +
    'ທີ່ມີຕໍ່ລະບົບ TonNam Smart Restaurant Management System (SRMS) ' +
    'ຂໍ້ມູນທີ່ໄດ້ຮັບ ຈະຖືກນຳໃຊ້ເພື່ອ ປັບປຸງ ແລະ ພັດທະນາລະບົບ ໃຫ້ດີຂຶ້ນຍິ່ງຂຶ້ນ\n\n' +
    'ເກນການໃຫ້ຄະແນນ:\n' +
    '5 = ຫຼາຍທີ່ສຸດ / ເຫັນດີຢ່າງຍິ່ງ\n' +
    '4 = ຫຼາຍ / ເຫັນດີ\n' +
    '3 = ປານກາງ\n' +
    '2 = ໜ້ອຍ / ບໍ່ຄ່ອຍເຫັນດີ\n' +
    '1 = ໜ້ອຍທີ່ສຸດ / ບໍ່ເຫັນດີ'
  );

  form.setCollectEmail(false);
  form.setAllowResponseEdits(false);
  form.setConfirmationMessage(
    'ຂໍ້ຂອບໃຈ ສຳລັບການຕອບແບບສອບຖາມ!\nຂໍ້ມູນຂອງທ່ານ ມີຄຸນຄ່າຢ່າງຍິ່ງ ສຳລັບການພັດທະນາລະບົບ'
  );

  // ══════════════════════════════════════════════════════════════════════════
  // ສ່ວນທີ 1: ຂໍ້ມູນທົ່ວໄປຂອງຜູ້ຕອບ
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeader(form,
    'ສ່ວນທີ 1: ຂໍ້ມູນທົ່ວໄປຂອງຜູ້ຕອບ',
    'ກະລຸນາຕອບຂໍ້ມູນທົ່ວໄປ ເພື່ອໃຊ້ໃນການວິເຄາະ'
  );

  // 1.1 ເພດ
  const genderItem = form.addMultipleChoiceItem();
  genderItem
    .setTitle('ເພດ')
    .setChoiceValues(['ຊາຍ', 'ຍິງ', 'ບໍ່ລະບຸ'])
    .setRequired(true);

  // 1.2 ອາຍຸ
  const ageItem = form.addMultipleChoiceItem();
  ageItem
    .setTitle('ອາຍຸ')
    .setChoiceValues([
      'ຕ່ຳກວ່າ 18 ປີ',
      '18 – 25 ປີ',
      '26 – 35 ປີ',
      '36 – 45 ປີ',
      'ຫຼາຍກວ່າ 45 ປີ',
    ])
    .setRequired(true);

  // 1.3 ຕຳແໜ່ງ
  const roleItem = form.addMultipleChoiceItem();
  roleItem
    .setTitle('ຕຳແໜ່ງ / ບົດບາດ')
    .setChoiceValues([
      'ພະນັກງານເສີບ (Waiter)',
      'ແຄັດເຊຍ (Cashier)',
      'ພະນັກງານຫ້ອງຄົວ (Kitchen)',
      'ຜູ້ຈັດການຮ້ານ ຫຼື ເຈົ້າຂອງຮ້ານ (Admin)',
      'ຜູ້ໃຊ້ທົ່ວໄປ (Normal User)',
    ])
    .setRequired(true);

  // ══════════════════════════════════════════════════════════════════════════
  // ສ່ວນທີ 2: ດ້ານເນື້ອຫາ
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeader(form,
    'ສ່ວນທີ 2: ດ້ານເນື້ອຫາ',
    'ຂໍ້ມູນ ແລະ ເນື້ອຫາທີ່ລະບົບສະແດງ ຄົບຖ້ວນ ຖືກຕ້ອງ ແລະ ເຂົ້າໃຈງ່າຍຫຼາຍສໍ່າໃດ'
  );

  const contentQuestions = [
    'ຂໍ້ມູນລາຍການອາຫານ (ຊື່, ລາຄາ, ປະເພດ) ສະແດງໄດ້ຄົບຖ້ວນ ແລະ ຖືກຕ້ອງ',
    'ຂໍ້ຄວາມ ແລະ ຂໍ້ມູນຕ່າງໆ ທີ່ສະແດງໃນລະບົບ ເຂົ້າໃຈໄດ້ງ່າຍ ແລະ ຊັດເຈນ',
    'ສະຖານະຂອງໂຕະ (ວ່າງ, ມີລູກຄ້າ, ຊຳລະແລ້ວ) ສະແດງໄດ້ຊັດເຈນ ຮັບຮູ້ໄດ້ທັນທີ',
    'ລາຍລະອຽດຂອງລາຍການສັ່ງ (ຊື່ເມນູ, ຈຳນວນ, ລາຄາ) ສະແດງໄດ້ຄົບ ແລະ ຖືກຕ້ອງ',
    'ຂໍ້ຄວາມຢືນຢັນ ຫຼື ແຈ້ງເຕືອນຕ່າງໆ ຈາກລະບົບ ໃຊ້ພາສາທີ່ຊັດເຈນ ແລະ ເໝາະສົມ',
  ];

  contentQuestions.forEach(q => addLikertQuestion(form, q));

  // ══════════════════════════════════════════════════════════════════════════
  // ສ່ວນທີ 3: ດ້ານການອອກແບບ (UX/UI)
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeader(form,
    'ສ່ວນທີ 3: ດ້ານການອອກແບບ (UX/UI)',
    'ຮູບລັກສະນ, ສີສັນ ແລະ ການຈັດວາງ ຂອງໜ້າຈໍ ສວຍງາມ ເໝາະສົມ ແລະ ໃຊ້ງ່າຍຫຼາຍສໍ່າໃດ'
  );

  const designQuestions = [
    'ສີສັນ ແລະ ຮູບແບບໂດຍລວມຂອງລະບົບ ສວຍງາມ ແລະ ດຶງດູດ',
    'ຕົວໜັງສືອ່ານງ່າຍ ຂະໜາດ ແລະ ຮູບແບບ ເໝາະສົມ ບໍ່ຕ້ອງຖ່ຽວຫາ',
    'ການຈັດວາງປຸ່ມ ແລະ ເມນູຕ່າງໆ ຊັດເຈນ ຊອກຫາສິ່ງທີ່ຕ້ອງການໄດ້ງ່າຍ',
    'ໜ້າຈໍ ໃຊ້ໄດ້ດີ ຢູ່ອຸປະກອນທີ່ຕ່ານໃຊ້ (ໂທລະສັບ ຫຼື ຄອມພິວເຕີ)',
    'ສີ ແລະ ສັນຍາລັກ ຊ່ວຍໃຫ້ຮູ້ຈັກສະຖານະຕ່າງໆ ໄດ້ທັນທີ ໂດຍບໍ່ຕ້ອງອ່ານທຸກຄຳ',
  ];

  designQuestions.forEach(q => addLikertQuestion(form, q));

  // ══════════════════════════════════════════════════════════════════════════
  // ສ່ວນທີ 4: ດ້ານການໃຊ້ງານ
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeader(form,
    'ສ່ວນທີ 4: ດ້ານການໃຊ້ງານ',
    'ຄວາມສະດວກ ແລະ ງ່າຍໃນການໃຊ້ງານລະບົບ ໃນຊີວິດປະຈຳວັນ'
  );

  const usabilityQuestions = [
    'ການໃຊ້ງານລະບົບໂດຍລວມ ງ່າຍ ແລະ ສະດວກ ບໍ່ຕ້ອງໃຊ້ຄວາມພະຍາຍາມຫຼາຍ',
    'ການສັ່ງອາຫານ ດຳເນີນການໄດ້ໄວ ທຸກຂັ້ນຕອນ ຊັດເຈນ ແລະ ງ່າຍ',
    'ການຊຳລະເງິນ ດຳເນີນການໄດ້ຖືກຕ້ອງ ແລະ ບໍ່ຊັບຊ້ອນ',
    'ເມື່ອເຮັດຜິດ ຫຼື ເກີດຄວາມຜິດພາດ ລະບົບແຈ້ງໃຫ້ຮູ້ຢ່າງຊັດເຈນ ແລະ ສາມາດແກ້ໄຂໄດ້ງ່າຍ',
    'ສາມາດຮຽນຮູ້ ແລະ ເຂົ້າໃຊ້ລະບົບໄດ້ ໂດຍບໍ່ຕ້ອງໃຊ້ເວລາຝຶກຫັດດົນ',
  ];

  usabilityQuestions.forEach(q => addLikertQuestion(form, q));

  // ══════════════════════════════════════════════════════════════════════════
  // ສ່ວນທີ 5: ດ້ານປະສິດທິພາບ ແລະ ຄວາມປອດໄພ
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeader(form,
    'ສ່ວນທີ 5: ດ້ານປະສິດທິພາບ ແລະ ຄວາມປອດໄພ',
    'ຄວາມໄວ ຄວາມໜ້າເຊື່ອຖື ແລະ ຄວາມປອດໄພ ຂອງລະບົບ'
  );

  const performanceQuestions = [
    'ລະບົບໂຕ ແລະ ສະແດງຂໍ້ມູນໄດ້ໄວ ບໍ່ຕ້ອງລໍຖ້ານານ',
    'ຂໍ້ມູນຂອງໂຕະ ແລະ ໃບບິນ ອັບເດດທັນທີ ສອດຄ່ອງກັບຄວາມເປັນຈິງ',
    'ລະບົບໃຊ້ງານໄດ້ຢ່າງຕໍ່ເນື່ອງ ບໍ່ຄ່ອຍຂັດຂ້ອງ ຫຼື ລົ້ມເຫລວ',
    'ການໃສ່ລະຫັດຜ່ານ ເພື່ອເຂົ້າໃຊ້ລະບົບ ຊ່ວຍໃຫ້ຮູ້ສຶກວ່າຂໍ້ມູນຂອງຮ້ານ ຖືກຮັກສາໄວ້ຢ່າງດີ',
    'ແຕ່ລະຕຳແໜ່ງ ເຂົ້າເຖິງໄດ້ສະເພາະ ສ່ວນທີ່ກ່ຽວຂ້ອງ ຕ່ານຮູ້ສຶກວ່ານີ້ ເໝາະສົມ ແລະ ປອດໄພ',
  ];

  performanceQuestions.forEach(q => addLikertQuestion(form, q));

  // ══════════════════════════════════════════════════════════════════════════
  // ສ່ວນທີ 6: ຄຳຄິດເຫັນ / ຄຳແນະນຳ (ຕອບ ຫຼື ບໍ່ ກໍ່ໄດ້)
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeader(form,
    'ສ່ວນທີ 6: ຄຳຄິດເຫັນ ແລະ ຄຳແນະນຳ',
    'ຖ້າທ່ານ ມີຂໍ້ສະເໜີ ຫຼື ຄຳຄິດເຫັນ ເພີ່ມເຕີມ ກະລຸນາຕອບໃນຊ່ອງຂ້າງລຸ່ມ (ບໍ່ບັງຄັບ)'
  );

  const suggestionItem = form.addParagraphTextItem();
  suggestionItem
    .setTitle('ຄຳຄິດເຫັນ ຫຼື ຄຳແນະນຳ ເພີ່ມເຕີມ')
    .setHelpText('ທ່ານຄິດວ່າ ລະບົບນີ້ ຄວນປັບປຸງ ຫຼື ເພີ່ມ ຫຍັງ ທີ່ຈະຊ່ວຍໃຫ້ການໃຊ້ງານ ດີຂຶ້ນ?')
    .setRequired(false);

  // ─── Log URL ────────────────────────────────────────────────────────────
  const formUrl  = form.getPublishedUrl();
  const editUrl  = form.getEditUrl();
  const shortUrl = form.shortenFormUrl(formUrl);

  Logger.log('✅ ສ້າງ Form ສຳເລັດ!');
  Logger.log('📋 Form Link (ສຳລັບສົ່ງໃຫ້ຜູ້ຕອບ): ' + shortUrl);
  Logger.log('✏️  Edit Link (ສຳລັບ Admin): '         + editUrl);

  return { formUrl, shortUrl, editUrl };
}

// ─── Helper Functions ────────────────────────────────────────────────────────

/**
 * ເພີ່ມ Section Header (ຫົວຂໍ້ໃຫຍ່)
 */
function addSectionHeader(form, title, description) {
  const item = form.addSectionHeaderItem();
  item.setTitle(title);
  if (description) item.setHelpText(description);
}

/**
 * ເພີ່ມຄຳຖາມ Likert Scale 1–5
 * ໃຊ້ ScaleItem ຂອງ Google Forms ເພື່ອໃຫ້ UI ສວຍ ແລະ ກຳນົດ Label ໄດ້
 */
function addLikertQuestion(form, questionText) {
  const item = form.addScaleItem();
  item
    .setTitle(questionText)
    .setBounds(1, 5)
    .setLabels('ໜ້ອຍທີ່ສຸດ', 'ຫຼາຍທີ່ສຸດ')
    .setRequired(true);
}
