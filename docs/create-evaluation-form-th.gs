/**
 * สร้างแบบสอบถามประเมินระบบ TonNam SRMS (ฉบับภาษาไทย)
 * Smart Restaurant Management System — แบบประเมินความพึงพอใจ
 *
 * วิธีใช้:
 *  1. เปิด Google Apps Script (script.google.com)
 *  2. สร้าง Project ใหม่ แล้ววางโค้ดนี้ไว้ใน Code.gs
 *  3. คลิก Run → createSRMSEvaluationFormTH
 *  4. อนุญาต Permission ให้ Script สร้าง Google Form
 *  5. Link ของ Form จะแสดงอยู่ใน Execution Log
 */

function createSRMSEvaluationFormTH() {
  // ─── สร้าง Form ─────────────────────────────────────────────────────────────
  const form = FormApp.create('แบบสอบถามการประเมินระบบ TonNam SRMS');

  form.setDescription(
    'แบบสอบถามนี้ มีจุดประสงค์เพื่อ ประเมินความพึงพอใจ และ ความคิดเห็นของท่าน ' +
    'ที่มีต่อระบบ TonNam Smart Restaurant Management System (SRMS) ' +
    'ข้อมูลที่ได้รับ จะถูกนำไปใช้เพื่อ ปรับปรุง และ พัฒนาระบบให้ดียิ่งขึ้น\n\n' +
    'เกณฑ์การให้คะแนน:\n' +
    '5 = มากที่สุด / เห็นด้วยอย่างยิ่ง\n' +
    '4 = มาก / เห็นด้วย\n' +
    '3 = ปานกลาง\n' +
    '2 = น้อย / ไม่ค่อยเห็นด้วย\n' +
    '1 = น้อยที่สุด / ไม่เห็นด้วย'
  );

  form.setCollectEmail(false);
  form.setAllowResponseEdits(false);
  form.setConfirmationMessage(
    'ขอบคุณสำหรับการตอบแบบสอบถาม!\nข้อมูลของท่าน มีคุณค่าอย่างยิ่งสำหรับการพัฒนาระบบ'
  );

  // ══════════════════════════════════════════════════════════════════════════
  // ส่วนที่ 1: ข้อมูลทั่วไปของผู้ตอบ
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeaderTH(form,
    'ส่วนที่ 1: ข้อมูลทั่วไปของผู้ตอบ',
    'กรุณาตอบข้อมูลทั่วไป เพื่อใช้ในการวิเคราะห์'
  );

  // 1.1 เพศ
  const genderItem = form.addMultipleChoiceItem();
  genderItem
    .setTitle('เพศ')
    .setChoiceValues(['ชาย', 'หญิง', 'ไม่ระบุ'])
    .setRequired(true);

  // 1.2 อายุ
  const ageItem = form.addMultipleChoiceItem();
  ageItem
    .setTitle('อายุ')
    .setChoiceValues([
      'ต่ำกว่า 18 ปี',
      '18 – 25 ปี',
      '26 – 35 ปี',
      '36 – 45 ปี',
      'มากกว่า 45 ปี',
    ])
    .setRequired(true);

  // 1.3 ตำแหน่ง
  const roleItem = form.addMultipleChoiceItem();
  roleItem
    .setTitle('ตำแหน่ง / บทบาท')
    .setChoiceValues([
      'พนักงานเสิร์ฟ (Waiter)',
      'แคชเชียร์ (Cashier)',
      'พนักงานครัว (Kitchen)',
      'ผู้จัดการร้านหรือเจ้าของร้าน (Admin)',
      'ผู้ใช้ทั่วไป (Normal User)',
    ])
    .setRequired(true);

  // ══════════════════════════════════════════════════════════════════════════
  // ส่วนที่ 2: ด้านเนื้อหา
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeaderTH(form,
    'ส่วนที่ 2: ด้านเนื้อหา',
    'ข้อมูลและเนื้อหาที่ระบบแสดง ครบถ้วน ถูกต้อง และเข้าใจง่ายเพียงใด'
  );

  const contentQuestions = [
    'ข้อมูลรายการอาหาร (ชื่อ, ราคา, ประเภท) แสดงได้ครบถ้วนและถูกต้อง',
    'ข้อความและข้อมูลต่าง ๆ ที่แสดงในระบบ เข้าใจได้ง่ายและชัดเจน',
    'สถานะของโต๊ะ (ว่าง, มีลูกค้า, ชำระแล้ว) แสดงได้ชัดเจน รับรู้ได้ทันที',
    'รายละเอียดของรายการสั่ง (ชื่อเมนู, จำนวน, ราคา) แสดงได้ครบและถูกต้อง',
    'ข้อความยืนยันหรือแจ้งเตือนต่าง ๆ จากระบบ ใช้ภาษาที่ชัดเจนและเหมาะสม',
  ];

  contentQuestions.forEach(q => addLikertQuestionTH(form, q));

  // ══════════════════════════════════════════════════════════════════════════
  // ส่วนที่ 3: ด้านการออกแบบ (UX/UI)
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeaderTH(form,
    'ส่วนที่ 3: ด้านการออกแบบ (UX/UI)',
    'รูปลักษณ์ สีสัน และการจัดวาง ของหน้าจอ สวยงาม เหมาะสม และใช้งานง่ายเพียงใด'
  );

  const designQuestions = [
    'สีสันและรูปแบบโดยรวมของระบบ สวยงามและน่าใช้งาน',
    'ตัวอักษรอ่านง่าย ขนาดและรูปแบบเหมาะสม ไม่ต้องเพ่ง',
    'การจัดวางปุ่มและเมนูต่าง ๆ ชัดเจน ค้นหาสิ่งที่ต้องการได้ง่าย',
    'หน้าจอใช้งานได้ดีกับอุปกรณ์ที่ใช้อยู่ (โทรศัพท์ หรือ คอมพิวเตอร์)',
    'สีและสัญลักษณ์ช่วยให้รู้สถานะต่าง ๆ ได้ทันที โดยไม่ต้องอ่านทุกคำ',
  ];

  designQuestions.forEach(q => addLikertQuestionTH(form, q));

  // ══════════════════════════════════════════════════════════════════════════
  // ส่วนที่ 4: ด้านการใช้งาน
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeaderTH(form,
    'ส่วนที่ 4: ด้านการใช้งาน',
    'ความสะดวกและง่ายในการใช้งานระบบ ในชีวิตประจำวัน'
  );

  const usabilityQuestions = [
    'การใช้งานระบบโดยรวม ง่ายและสะดวก ไม่ต้องใช้ความพยายามมาก',
    'การสั่งอาหาร ดำเนินการได้รวดเร็ว ทุกขั้นตอนชัดเจนและง่าย',
    'การชำระเงิน ดำเนินการได้ถูกต้องและไม่ซับซ้อน',
    'เมื่อทำผิดหรือเกิดความผิดพลาด ระบบแจ้งให้ทราบอย่างชัดเจนและแก้ไขได้ง่าย',
    'สามารถเรียนรู้และเริ่มใช้งานระบบได้ โดยไม่ต้องใช้เวลาฝึกนาน',
  ];

  usabilityQuestions.forEach(q => addLikertQuestionTH(form, q));

  // ══════════════════════════════════════════════════════════════════════════
  // ส่วนที่ 5: ด้านประสิทธิภาพและความปลอดภัย
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeaderTH(form,
    'ส่วนที่ 5: ด้านประสิทธิภาพและความปลอดภัย',
    'ความเร็ว ความน่าเชื่อถือ และความปลอดภัย ของระบบ'
  );

  const performanceQuestions = [
    'ระบบเปิดและแสดงข้อมูลได้รวดเร็ว ไม่ต้องรอนาน',
    'ข้อมูลของโต๊ะและใบบิล อัปเดตทันที สอดคล้องกับความเป็นจริง',
    'ระบบใช้งานได้อย่างต่อเนื่อง ไม่ค่อยขัดข้องหรือล้มเหลว',
    'การใส่รหัสผ่านเพื่อเข้าใช้งานระบบ ทำให้รู้สึกว่าข้อมูลของร้านได้รับการปกป้องเป็นอย่างดี',
    'แต่ละตำแหน่งเข้าถึงได้เฉพาะส่วนที่เกี่ยวข้อง ท่านรู้สึกว่านี่เหมาะสมและปลอดภัย',
  ];

  performanceQuestions.forEach(q => addLikertQuestionTH(form, q));

  // ══════════════════════════════════════════════════════════════════════════
  // ส่วนที่ 6: ความคิดเห็น / ข้อเสนอแนะ (ตอบหรือไม่ก็ได้)
  // ══════════════════════════════════════════════════════════════════════════
  addSectionHeaderTH(form,
    'ส่วนที่ 6: ความคิดเห็นและข้อเสนอแนะ',
    'หากท่านมีข้อเสนอแนะหรือความคิดเห็นเพิ่มเติม กรุณาตอบในช่องด้านล่าง (ไม่บังคับ)'
  );

  const suggestionItem = form.addParagraphTextItem();
  suggestionItem
    .setTitle('ความคิดเห็นหรือข้อเสนอแนะเพิ่มเติม')
    .setHelpText('ท่านคิดว่าระบบนี้ควรปรับปรุงหรือเพิ่มเติมอะไร ที่จะช่วยให้การใช้งานดีขึ้น?')
    .setRequired(false);

  // ─── Log URL ────────────────────────────────────────────────────────────
  const formUrl  = form.getPublishedUrl();
  const editUrl  = form.getEditUrl();
  const shortUrl = form.shortenFormUrl(formUrl);

  Logger.log('✅ สร้าง Form สำเร็จ!');
  Logger.log('📋 Form Link (สำหรับส่งให้ผู้ตอบ): ' + shortUrl);
  Logger.log('✏️  Edit Link (สำหรับ Admin): '       + editUrl);

  return { formUrl, shortUrl, editUrl };
}

// ─── Helper Functions ────────────────────────────────────────────────────────

/**
 * เพิ่ม Section Header (หัวข้อใหญ่)
 */
function addSectionHeaderTH(form, title, description) {
  const item = form.addSectionHeaderItem();
  item.setTitle(title);
  if (description) item.setHelpText(description);
}

/**
 * เพิ่มคำถาม Likert Scale 1–5
 * ใช้ ScaleItem ของ Google Forms เพื่อให้ UI สวยและกำหนด Label ได้
 */
function addLikertQuestionTH(form, questionText) {
  const item = form.addScaleItem();
  item
    .setTitle(questionText)
    .setBounds(1, 5)
    .setLabels('น้อยที่สุด', 'มากที่สุด')
    .setRequired(true);
}
